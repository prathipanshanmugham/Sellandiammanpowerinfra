# Copy to backend/.env and fill in. Keep it private (chmod 600). Never commit it.

# --- required
JWT_SECRET=                  # 64 random characters:  openssl rand -hex 32
SITE_URL=https://www.sellandiammanpowerinfra.com
CORS_ORIGINS=https://www.sellandiammanpowerinfra.com,https://sellandiammanpowerinfra.com
COOKIE_SECURE=true

# --- first sign-in (remove ADMIN_PASSWORD after you have signed in and set up 2-step sign-in)
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# --- password vault: 32 random bytes. Never change it once logins are saved; keep a copy off the server.
VAULT_KEY=                   # openssl rand -base64 32

# --- email (notifications, set-password links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sellandiamman Power Infra <no-reply@sellandiammanpowerinfra.com>
SMTP_TLS=true

# --- WhatsApp Business Cloud API (enquiry acknowledgements, breakdown alerts, approval codes)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# --- lead webhooks: IndiaMART, JustDial, Meta and Google lead forms post to /api/hooks/leads/<source>?key=...
LEAD_WEBHOOK_KEY=            # openssl rand -hex 16

# --- spam protection on website forms (Cloudflare Turnstile) and analytics
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
GA4_ID=

# --- leave these alone in production
SEED_DEMO=false
DEMO_OTP_ANY=false
DISABLE_RATE_LIMIT=false
DISABLE_AUTOMATIONS=false
